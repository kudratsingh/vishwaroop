{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:omni-world:trajectory:validation-ledger:1.0.0",
  "title": "One line of an append-only validation ledger: evidence attached to an episode after export",
  "description": "Episode manifests are written once. Later evidence (a physics replay of an imagined episode's actions, a physical assessment of a real episode) is appended here and merged by validate.py --ledger. Artifact paths are relative to the ledger file's directory.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "record_id", "ts", "episode_id", "status", "evidence", "protocol_version", "actor", "notes"],
  "properties": {
    "schema_version": {"const": "1.0.0"},
    "record_id": {"type": "string", "minLength": 1},
    "ts": {"type": "string", "format": "date-time"},
    "episode_id": {"type": "string", "minLength": 1},
    "status": {"enum": ["generated", "replay_checked", "physically_evaluated"]},
    "evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "assessed_episode_id", "artifact"],
      "properties": {
        "kind": {"enum": ["generation", "physics_replay", "physical_assessment"]},
        "assessed_episode_id": {"type": "string", "minLength": 1},
        "artifact": {
          "type": "object",
          "additionalProperties": false,
          "required": ["path", "sha256"],
          "properties": {
            "path": {"type": "string", "minLength": 1},
            "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"}
          }
        }
      }
    },
    "protocol_version": {"type": "string", "minLength": 1},
    "actor": {"type": "string", "minLength": 1},
    "notes": {"type": "string"}
  }
}
